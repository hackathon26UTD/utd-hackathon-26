# Server-only MongoDB connection. Never expose this value in browser code.
# This default connects to the optional local Docker Compose database.
MONGODB_URI=mongodb://127.0.0.1:27017/utd_hackathon_26
MONGODB_DB=utd_hackathon_26

# For Atlas, replace MONGODB_URI in your ignored .env with the connection
# string from Atlas. Percent-encode special characters in its credentials.

# Server/local-only infrastructure management credentials; never expose in browsers.
GITHUB_TOKEN=
MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=
MONGODB_ATLAS_ORG_ID=
MONGODB_ATLAS_PROJECT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Existing Cloudflare Global API Key authentication (alternative to API token).
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=

# Copy to .env.local. All values stay on the server; never use NEXT_PUBLIC_ for secrets.
# The built-in fictional demo works without external services.
NESSIE_API_KEY=
# Populated by: node scripts/seed-nessie.mjs
NESSIE_CUSTOMER_ID=

# Optional shared storage. Leave blank to use browser-only saved plans.
MONGODB_URI=
MONGODB_DB=futureyou

# Optional explanations. The calculation engine never depends on AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

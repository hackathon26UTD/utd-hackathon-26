# Team credentials template. Copy to `.env` (git-ignored) on YOUR machine:
#   cp .env.example .env
# Never commit real values, paste them in chat, or put them in browser code.
# Every script loads this file automatically (scripts/env.mjs).
# Check what works:  npm run access   (prints OK/missing, never the values)

# ── GitHub ───────────────────────────────────────────────────────────────
# Leave blank: scripts use your existing `gh auth login` session automatically.
# Only set this on machines without the GitHub CLI.
GITHUB_TOKEN=
GITHUB_REPO=hackathon26UTD/utd-hackathon-26

# ── MongoDB app connection (what the API uses to read/write data) ─────────
# Atlas app-user connection string (get it privately from Ayan, or Atlas →
# Connect → Drivers). For local Docker instead: mongodb://127.0.0.1:27017/utd_hackathon_26
MONGODB_URI=
MONGODB_DB=utd_hackathon_26

# ── MongoDB Atlas Admin API (manage the cluster: IP access, users, status) ─
# Not secret: the team's Atlas organization and project.
MONGODB_ATLAS_ORG_ID=6aef85bf7e6ae4b2af6a2bed
MONGODB_ATLAS_PROJECT_ID=6aef85f3b64186873a7b77ad
# Option A (recommended): Service Account
#   Atlas → Organization → Access Manager → Applications → Service Accounts
MONGODB_ATLAS_CLIENT_ID=
MONGODB_ATLAS_CLIENT_SECRET=
# Option B (legacy): API Key, Atlas → Access Manager → Applications → API Keys
MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=

# ── Cloudflare (deploys; Ayan owns the account) ───────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Alternative: existing Global API Key authentication
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=

# ── Team API (deployed site) ──────────────────────────────────────────────
API_BASE=https://utd-hackathon-26.pages.dev
# Admin bearer key: get it privately from Ayan. Used to register devices.
API_ADMIN_KEY=

# ── Hardware boxes (npm run provision) ─────────────────────────────────────
# 2.4 GHz hotspot the boxes join (ESP32 cannot use 5 GHz).
WIFI_SSID=
WIFI_PASS=

# ── Public data feeds (free sign-ups) ─────────────────────────────────────
# https://www.eia.gov/opendata/register.php   (grid demand/generation)
EIA_API_KEY=
# https://docs.airnowapi.org/account/request/ (outdoor air quality)
# Old /aq/observation/zipCode/current endpoints were retired Oct 1 2026 (HTTP 410).
# Use /aq/observation/current/ziplatLong?zipCode=..&format=application/json&api_key=..
AIRNOW_API_KEY=
# https://firms.modaps.eosdis.nasa.gov/api/map_key/ (wildfire hotspots)
FIRMS_MAP_KEY=

# ── Optional AI (Nvidia track) ────────────────────────────────────────────
NVIDIA_API_KEY=

# HomeBeacon private reads and synthetic seed configuration
API_PUBLIC_READ=false
# Seed only: random local secret (24+ chars); keys append -1, -2 or -3.
BEACON_DEMO_DEVICE_KEY=

# Local-only Pages read/metadata/write management token for npm run site.
CLOUDFLARE_SITE_API_TOKEN=

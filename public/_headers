/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://tiles.openfreemap.org https://basemap.nationalmap.gov https://opengeo.ncep.noaa.gov; connect-src 'self' https://tiles.openfreemap.org https://basemap.nationalmap.gov https://opengeo.ncep.noaa.gov; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Content-hashed build output (see scripts/build-ui.mjs): safe to cache for a year.
/assets/chunks/*
  Cache-Control: public, max-age=31536000, immutable
/assets/media/*
  Cache-Control: public, max-age=31536000, immutable
# Entry bundles keep stable names, so they keep the Pages default (revalidate with ETag on every visit).
# Do not add an /assets/* rule: Pages joins matching rules, which would add that to the hashed files too.
# Static files without hashes: a day fresh, then refresh in the background for a week.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

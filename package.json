{
  "name": "utd-hackathon-26",
  "version": "1.0.0",
  "description": "Team workspace for UTD Hackathon 2026: four people, one focused MVP, one reliable demo.",
  "scripts": {
    "dev": "wrangler pages dev public",
    "build": "npm run build:ui && wrangler pages functions build functions --outdir=.cloudflare-build --compatibility-date=2026-11-07 --compatibility-flags=nodejs_compat",
    "deploy": "node scripts/deploy.mjs",
    "test": "node --test test/*.test.js",
    "test:db": "node --env-file-if-exists=.dev.vars scripts/check-mongodb.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "build:ui": "node scripts/build-ui.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackathon26UTD/utd-hackathon-26.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/hackathon26UTD/utd-hackathon-26/issues"
  },
  "homepage": "https://github.com/hackathon26UTD/utd-hackathon-26#readme",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "esbuild": "0.28.2",
    "mongodb-memory-server": "11.3.0",
    "wrangler": "4.158.0"
  },
  "private": true,
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.2.7",
    "maplibre-gl": "6.16.0",
    "mongodb": "7.8.0"
  }
}

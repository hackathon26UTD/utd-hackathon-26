# Copy to .dev.vars for local Pages Functions. Never commit real credentials.
# Server-only MongoDB database connection; never expose this URI to browsers.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGODB_DB=utd_hackathon_26
# Admin bearer key for write/management endpoints. Generate: npm run keygen
API_ADMIN_KEY=
# true = unauthenticated GET on devices/readings/alerts/events/store (dashboard demos)
API_PUBLIC_READ=true
# Comma-separated allowed origins for browser calls, or *
CORS_ORIGINS=*

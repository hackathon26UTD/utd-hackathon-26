# Copy to .dev.vars for local Pages Functions. Never commit real credentials.
# Server-only MongoDB database connection; never expose this URI to browsers.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGODB_DB=utd_hackathon_26
# Admin bearer key for write/management endpoints. Generate: npm run keygen
API_ADMIN_KEY=
# true = unauthenticated GET on devices/readings/alerts/events/store (dashboard demos)
API_PUBLIC_READ=false
# Comma-separated allowed origins for browser calls, or *
CORS_ORIGINS=*

# Optional NVIDIA hosted API or a team-hosted OpenAI-compatible NIM endpoint.
# Keep credentials server-side. Never prefix secrets with PUBLIC or VITE.
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional household mail; leave off until a sender is intentionally connected.
HOME_EMAIL_ENABLED=false
HOME_EMAIL_FROM=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

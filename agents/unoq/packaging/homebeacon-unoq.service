[Unit]
Description=HomeBeacon Uno Q agent (sensor monitor, uplink and low-power manager)
Documentation=https://utd-hackathon-26.pages.dev/downloads/unoq/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homebeacon
Group=homebeacon
SupplementaryGroups=dialout
# The device key lives in a root-only file read by systemd, never in the config or on a command line.
EnvironmentFile=-/etc/homebeacon/unoq.env
ExecStart=/usr/bin/python3 /opt/homebeacon-unoq/current/run_agent.py --config /etc/homebeacon/unoq.toml run
# Exit code 75 comes from the allowlisted "reboot-agent" command and restarts at once.
Restart=always
RestartSec=10
RestartForceExitStatus=75
# Bounded resources: the agent must never starve the system or add power draw.
Nice=10
CPUQuota=25%
MemoryMax=96M
TasksMax=32
LimitNOFILE=64
# Hardening
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
LockPersonality=true
DevicePolicy=closed
DeviceAllow=char-ttyACM rw
DeviceAllow=char-ttyUSB rw
ReadWritePaths=/var/lib/homebeacon-unoq

[Install]
WantedBy=multi-user.target

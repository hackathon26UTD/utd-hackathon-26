[Unit]
Description=HomeBeacon Uno Q agent (sensor monitor, uplink and low-power manager)
Documentation=https://utd-hackathon-26.pages.dev/downloads/unoq/
After=network-online.target
Wants=network-online.target
# Never give up restarting: a hub that stays down is worse than one that retries. The boot guard, not
# systemd's start limit, decides when an update has failed too often and rolls it back.
StartLimitIntervalSec=0

[Service]
Type=simple
User=homebeacon
Group=homebeacon
SupplementaryGroups=dialout
# The device key lives in a root-only file read by systemd, never in the config or on a command line.
EnvironmentFile=-/etc/homebeacon/unoq.env
# Boot guard: counts this start, and rolls an unconfirmed update back after repeated failed starts. It lives
# outside the releases so a broken release cannot disable it. The leading "-" means a guard problem never blocks a start.
ExecStartPre=-/usr/bin/python3 -I -B /usr/local/libexec/homebeacon-unoq/bootguard.py pre-start --prefix /opt/homebeacon-unoq --state /var/lib/homebeacon-unoq
ExecStart=/usr/bin/python3 /opt/homebeacon-unoq/current/run_agent.py --config /etc/homebeacon/unoq.toml run
# Exit code 75 comes from the allowlisted "reboot-agent" command and from a finished self-update or rollback;
# it restarts at once. Any other exit also restarts (Restart=always), after RestartSec.
Restart=always
RestartSec=10
RestartForceExitStatus=75
# Bounded resources: the agent must never starve the system or add power draw.
Nice=10
CPUQuota=25%
MemoryMax=96M
TasksMax=32
LimitNOFILE=64
# Hardening
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
LockPersonality=true
DevicePolicy=closed
DeviceAllow=char-ttyACM rw
DeviceAllow=char-ttyUSB rw
# State, plus the install prefix so the agent can stage and switch releases itself. Logs belong under the state dir.
ReadWritePaths=/var/lib/homebeacon-unoq /opt/homebeacon-unoq

[Install]
WantedBy=multi-user.target
